{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // "composite": true,
    "lib": ["esnext", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "types": ["node", "mocha", "chai", "chai-as-promised"],
    "noEmit": true
  },
  "include": [
    "hardhat.config.ts",
    "ignition/**/*.ts",
    "test/**/*.ts",
    "artifacts/**/*",
    "hardhat-plugins/**/*.ts",
    "src/types"
  ],
  "exclude": ["node_modules"]
}
